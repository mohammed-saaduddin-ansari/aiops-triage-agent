# Copy to .env and fill in. Never commit .env.
# Every setting has a safe default; with nothing set the service runs in
# offline mode (FakeLLM, no external calls to an LLM provider).

# --- LLM -------------------------------------------------------------------
# "fake" (deterministic, offline) or "anthropic".
TRIAGE_LLM_PROVIDER=fake
# Read by the official SDK. Leave empty for offline mode.
ANTHROPIC_API_KEY=
TRIAGE_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
TRIAGE_LLM_EFFORT=medium
TRIAGE_LLM_MAX_TOKENS=16000
TRIAGE_LLM_TIMEOUT_SECONDS=120
# Server-side refusal fallback ("default" or "off"); only sent for models that support it.
TRIAGE_LLM_FALLBACKS=default

# --- Agent budgets ---------------------------------------------------------
TRIAGE_MAX_STEPS=8
TRIAGE_MAX_TOOL_CALLS=16
TRIAGE_TOKEN_BUDGET=120000
TRIAGE_TOOL_TIMEOUT_SECONDS=10
TRIAGE_TOOL_RESULT_MAX_CHARS=6000
# Comma-separated allow-list. Remove a tool here to stop the agent seeing it.
TRIAGE_ALLOWED_TOOLS=prometheus_query,prometheus_range_query,k8s_get_pods,k8s_describe_pod,k8s_get_events,k8s_rollout_history,loki_search,runbook_lookup

# --- Correlation -----------------------------------------------------------
TRIAGE_CORRELATION_WINDOW_SECONDS=300
TRIAGE_CORRELATION_GROUP_BY=alertname,namespace,workload
TRIAGE_DEBOUNCE_SECONDS=5
TRIAGE_MAX_CONCURRENT_TRIAGES=2

# --- Data sources (read-only) ----------------------------------------------
TRIAGE_PROMETHEUS_URL=http://prometheus:9090
TRIAGE_LOKI_URL=http://loki:3100
# "auto" tries in-cluster config then ~/.kube/config; "off" disables k8s tools.
TRIAGE_KUBERNETES_MODE=off
# Empty means any namespace the service account can read.
TRIAGE_KUBERNETES_NAMESPACES=
TRIAGE_RUNBOOK_DIR=runbooks

# --- Service ----------------------------------------------------------------
# Bearer token Alertmanager must send (http_config.authorization). Empty disables the check.
TRIAGE_WEBHOOK_TOKEN=
# Bearer token required to approve or reject proposals. Empty disables approvals entirely.
TRIAGE_APPROVAL_TOKEN=change-me-to-a-long-random-string
TRIAGE_AUDIT_LOG_PATH=var/audit.jsonl

# --- Observability -----------------------------------------------------------
# Standard OTel variable; leave empty to keep spans in-process only.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aiops-triage-agent

# --- Cost estimation (optional) ---------------------------------------------
# Set these from your provider's current price list to get a cost estimate
# per triage. Left empty, the service reports tokens only.
TRIAGE_PRICE_INPUT_PER_MTOK=
TRIAGE_PRICE_OUTPUT_PER_MTOK=
TRIAGE_PRICE_CACHE_READ_PER_MTOK=
TRIAGE_PRICE_CACHE_WRITE_PER_MTOK=
